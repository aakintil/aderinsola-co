---
import Base from '../layouts/Base.astro';
import WorkIndex from '../components/WorkIndex.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Draft from '../components/Draft.astro';
import { getCollection } from 'astro:content';
import { getProjects } from '../lib/projects';
import { SHOW_DRAFTS } from '../lib/drafts';
import { site } from '../lib/site';

const projects = await getProjects();
const archiveEntries = (await getCollection('archive', ({ data }) => SHOW_DRAFTS || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
// Same groups as the archive page: product work, then studio work
const archive = [
  { title: 'Product work', names: archiveEntries.filter((e) => e.data.group === 'product').map((e) => e.data.name) },
  { title: 'Blue Meridian studio', names: archiveEntries.filter((e) => e.data.group === 'studio').map((e) => e.data.name) },
].filter((g) => g.names.length);

const colleagues = [
  {
    quote:
      'He’s not just the person that makes products look, feel and work better, he’s the kind of person who makes the projects and people around him better, too.',
    cite: 'Celine Ryan · Clean energy programs and partnerships, worked with Ade at BDC',
  },
  {
    quote:
      'Aderinsola has a great ability to take very technical information, specifications and details and convert them into amazing user experiences.',
    cite: 'Brian Peet · Managed Ade at Sorcero',
  },
  {
    quote: 'His calmness during times of high stress and on complex projects is an asset.',
    cite: 'Javonne Lane · Communications and content lead, worked with Ade at BDC',
  },
];
---

<Base>
  <header class="gutter col top">
    <a class="crumb" href="/" aria-current="page" data-enter>{site.name} <span>/ {site.role}</span></a>
  </header>

  <main id="main">
    <WorkIndex projects={projects} archive={archive} />

    <div class="gutter col intro">
      <div class="prose">
        <h1 class="statement" data-enter style="--d:520">{site.description}</h1>
        <p>Most recently I led design for every digital product at The Switch Is On, a home electrification program.</p>
        <p>
          Previously, AI for life sciences at Sorcero, research tools at Nike, healthcare at Cigna, and CPO at Gokada in
          Lagos. HCI at Carnegie Mellon.
        </p>
        {
          site.email ? (
            <p>
              I’d love to say hello, so <a href={`mailto:${site.email}`}>send me an email</a>.
            </p>
          ) : (
            <Draft block>
              <p>
                I’d love to say hello, so <a href="#">send me an email</a>. [Add the address in src/lib/site.ts]
              </p>
            </Draft>
          )
        }
      </div>

      <section class="say" aria-labelledby="say">
        <h2 class="eyebrow quiet" id="say">What colleagues say</h2>
        {
          colleagues.map((c) => (
            <figure class="tq">
              <blockquote>
                <p>“{c.quote}”</p>
              </blockquote>
              <figcaption>{c.cite}</figcaption>
            </figure>
          ))
        }
      </section>
    </div>
  </main>

  <div class="gutter col">
    <SiteFooter links={[{ label: 'Archive', href: '/archive' }]} />
  </div>
</Base>

<script>
  import '../scripts/home';
</script>

<style>
  .top {
    padding-top: 44px;
  }
  .intro {
    padding-top: var(--gap-section);
  }
  .statement {
    margin-bottom: 4px;
  }
  .say {
    display: flex;
    flex-direction: column;
    gap: var(--gap-related);
    padding-top: var(--gap-section);
  }
  /* The section label binds to the list, closer than the quotes sit to each other */
  .say > h2 {
    margin-bottom: calc(var(--gap-media) - var(--gap-related));
  }
  .tq {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
    margin: 0;
  }
  .tq blockquote,
  .tq p {
    margin: 0;
  }
  .tq p {
    font-family: var(--display);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: pretty;
  }
  figcaption {
    font-size: 13px;
    color: var(--muted);
  }
</style>
