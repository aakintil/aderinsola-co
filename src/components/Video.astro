---
/**
 * Muted, looping product video (WebM + MP4 + poster) from public/media.
 * src/scripts/video.ts plays it while on screen, except under reduced motion.
 * Without JS it shows native controls.
 */
import { getImage } from 'astro:assets';
import { image } from '../lib/images';
import type { Tone } from '../lib/site';

interface Props {
  /** Path in public/media without extension, e.g. "hub/portal-approve" */
  src: string;
  /** Poster image key in src/assets/img */
  poster: string;
  label: string;
  tone?: Tone;
  ratio?: string;
  large?: boolean;
}

const { src, poster, label, tone = 'hub', ratio, large = true } = Astro.props;
const meta = image(poster);
const posterImg = await getImage({ src: meta, format: 'webp', width: Math.min(meta.width, 1600), quality: 80 });
const aspect = ratio ?? `${meta.width}/${meta.height}`;
---

<div class:list={['vid', { large }]} style={`--tone:var(--t-${tone});aspect-ratio:${aspect}`} data-video>
  <video
    poster={posterImg.src}
    width={meta.width}
    height={meta.height}
    muted
    loop
    playsinline
    controls
    preload="none"
    aria-label={label}
  >
    <source src={`/media/${src}.webm`} type="video/webm" />
    <source src={`/media/${src}.mp4`} type="video/mp4" />
  </video>
</div>

<style>
  .vid {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tone);
  }
  .large {
    border-radius: var(--radius-lg);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
