---
import Media from './Media.astro';
import { projectHref, type Project } from '../lib/projects';
import { pad2 } from '../lib/site';

interface Props {
  project: Project;
  number: number;
}
const { project, number } = Astro.props;
const { hero, tone, title } = project.data;
// The next project's own hero, so the picture you click is the one you land on.
// Kept at the hero's proportions; a cover hero without a set ratio shows at about the 2:1 it has on desktop.
const ratio = hero.ratio ?? (hero.fit === 'cover' ? '2/1' : undefined);
---

<a class="next" href={projectHref(project)}>
  <span class="label">Next · {pad2(number)}</span>
  <Media src={hero.src} alt="" fit={hero.fit} tone={hero.tone ?? tone} bg={hero.bg} focus={hero.focus} ratio={ratio} large />
  <span class="t">{title} <span aria-hidden="true">→</span></span>
</a>

<style>
  .next {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 22px 70px;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .t {
    font-family: var(--display);
    font-weight: 400;
    font-size: 30px;
    letter-spacing: var(--track-head);
    color: var(--fg);
    transition: color 0.2s;
  }
  .next:hover .t {
    color: var(--link);
  }
  .next :global(.ph .shot) {
    transition: transform 0.6s var(--ease);
  }
  .next:hover :global(.ph .shot) {
    transform: scale(1.015);
  }
</style>
