---
/**
 * Home project list.
 * Desktop: one large image stage; hovering or focusing a project crossfades it.
 * Mobile (720px and below): a scroll-snap swipe strip above the same list. Cards with a
 * walkthrough play a lighter, tall-cropped version of it.
 * The list and the strip both end with the archive, shown as a panel of its project names.
 * Behavior lives in src/scripts/home.ts. Without JS the list links still work.
 */
import { getImage } from 'astro:assets';
import Media from './Media.astro';
import { image } from '../lib/images';
import { projectHref, type Project } from '../lib/projects';
import { pad2 } from '../lib/site';

interface Props {
  projects: Project[];
  /** Archive project names by group, in order. */
  archive: { title: string; names: string[] }[];
}
const { projects, archive } = Astro.props;
const archiveCount = archive.reduce((n, g) => n + g.names.length, 0);
const first = projects[0]!;
// The archive is the last stop in both the list and the strip.
const total = pad2(projects.length + 1);

// Projects with a stage video get a poster, shown until the video plays (and always without JS).
const posters = await Promise.all(
  projects.map((p) =>
    p.data.card.video ? getImage({ src: image(p.data.card.video.poster), width: 1600, format: 'webp', quality: 80 }) : null,
  ),
);
const mobilePosters = await Promise.all(
  projects.map((p) => {
    const m = p.data.card.video?.mobile;
    return m ? getImage({ src: image(m.poster), width: 720, format: 'webp', quality: 80 }) : null;
  }),
);
---

<section class="work gutter" aria-label="Selected work" data-work>
  <div class="stage-wrap" data-enter="stage" style="--d:120">
    <a class="stage" href={projectHref(first)} tabindex="-1" aria-hidden="true">
      {
        projects.map((p, i) => {
          const video = p.data.card.video;
          const poster = posters[i];
          return video && poster ? (
            <div
              class:list={['layer', 'vlayer', { on: i === 0 }]}
              style={`background:var(--t-${p.data.tone})`}
              data-i={i}
            >
              {/* The first project's video autoplays natively; the others load nothing until
                  selected, then home.ts plays them. Sources only match on desktop, so phones
                  (where the stage is hidden) download nothing. home.ts also pauses offscreen
                  and does not autoplay under reduced motion. */}
              <video
                poster={poster.src}
                autoplay={i === 0}
                preload={i === 0 ? undefined : 'none'}
                muted
                loop
                playsinline
              >
                <source src={`/media/${video.src}.mp4`} type="video/mp4" media="(min-width: 721px)" />
              </video>
            </div>
          ) : (
            <Media
              class:list={['layer', { on: i === 0 }]}
              src={p.data.card.src}
              alt=""
              fit={p.data.card.fit}
              tone={p.data.tone}
              bg={p.data.card.bg}
              size="wide"
              only="desktop"
              priority={i === 0}
            />
          );
        })
      }
      <div class="layer alayer" aria-hidden="true">
        <p class="label">Archive · {archiveCount} more projects</p>
        <div class="acols">
          {archive.map((g) => (
            <div>
              <p class="agroup-t">{g.title}</p>
              <ul class="anames">
                {g.names.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </a>
  </div>

  <div class="mstrip" tabindex="0" role="region" aria-label="Projects, swipe sideways" data-mstrip>
    {
      projects.map((p, i) => (
        <a class:list={['mcard', { on: i === 0 }]} href={projectHref(p)} data-i={i} aria-label={`Open ${p.data.title}`}>
          {p.data.card.video?.mobile && mobilePosters[i] ? (
            <div class="mvid">
              {/* Sources only match on phones, so desktop downloads nothing. The first card
                  autoplays natively; home.ts plays whichever card is centered. */}
              <video
                poster={mobilePosters[i]!.src}
                autoplay={i === 0}
                preload={i === 0 ? undefined : 'none'}
                muted
                loop
                playsinline
              >
                <source src={`/media/${p.data.card.video.mobile.src}.mp4`} type="video/mp4" media="(max-width: 720px)" />
              </video>
            </div>
          ) : (
            <Media
              src={p.data.card.tall ?? p.data.card.src}
              alt=""
              fit={p.data.card.tall ? 'cover' : p.data.card.fit}
              tone={p.data.tone}
              bg={p.data.card.bg ?? (p.data.card.fit === 'flat' ? `var(--t-${p.data.tone})` : undefined)}
              ratio="4/5"
              size="full"
              only="mobile"
              priority={i === 0}
            />
          )}
        </a>
      ))
    }
    <a class="mcard" href="/archive" data-i={projects.length} aria-label={`Open the archive, ${archiveCount} more projects`}>
      <div class="marc" aria-hidden="true">
        <p class="label">Archive · {archiveCount} more projects</p>
        <div class="acols">
          {archive.map((g) => (
            <div>
              <p class="agroup-t">{g.title}</p>
              <ul class="anames">
                {g.names.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </a>
  </div>
  <div class="mcount label" aria-hidden="true">
    <span data-mnum>01 / {total} · Tap to open</span>
    <span class="dots">{[...projects, null].map((_, i) => <i class:list={{ on: i === 0 }} />)}</span>
    <span data-mhint>Swipe →</span>
  </div>

  <div class="col">
    <ol class="index">
      {
        projects.map((p, i) => (
          <li data-enter="fade" style={`--d:${360 + i * 60}`}>
            <a class="pick" href={projectHref(p)} data-i={i} data-on={i === 0 ? '' : undefined}>
              <span class="n">{p.data.title}</span>
              <span class="r">
                {p.data.card.result} <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
      <li data-enter="fade" style={`--d:${360 + projects.length * 60}`}>
        <a class="pick pick-archive" href="/archive" data-i={projects.length}>
          <span class="n">Archive</span>
          <span class="r">
            {archiveCount} more projects <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ol>
  </div>
</section>

<style>
  .work {
    padding-top: 36px;
  }

  /* ---------- desktop stage ---------- */
  .stage-wrap {
    position: relative;
    max-width: 1200px;
    margin-inline: auto;
  }
  .stage {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
  }
  .stage :global(.layer) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
    opacity: 0;
    transition: opacity var(--t-swap) var(--ease);
  }
  .stage :global(.layer.on) {
    opacity: 1;
  }
  /* Archive panel: the project names, set large on the stage gradient */
  .alayer,
  .marc {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 32px);
    padding: 0 5%;
    background: linear-gradient(135deg, #f5f7f9, #dce3ee 50%, #c6d1e1);
  }
  .alayer .label,
  .marc .label {
    margin: 0;
    color: var(--accent);
  }
  .acols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5%;
  }
  .agroup-t {
    margin: 0 0 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .anames {
    display: flex;
    flex-direction: column;
    gap: 0.14em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--display);
    font-weight: var(--bold);
    font-size: clamp(28px, 3.7vw, 46px);
    line-height: 1;
    letter-spacing: var(--track-head);
    color: var(--fg);
    text-wrap: balance;
  }
  .vlayer video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- list ---------- */
  .col {
    max-width: var(--col); /* same edges as the text column below */
  }
  .index {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .index li {
    border-top: 1px solid var(--line);
  }
  .pick {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    text-decoration: none;
  }
  .n {
    color: var(--muted);
    transition:
      color 0.2s,
      transform 0.3s var(--ease);
  }
  .r {
    flex: none;
    font-size: 13px;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .pick:hover .n,
  .pick[data-on] .n {
    color: var(--accent);
  }
  .pick[data-on] .n {
    transform: translateX(6px);
  }
  .pick[data-on] .r,
  .pick:focus-visible .r {
    opacity: 1;
  }

  /* ---------- mobile strip ---------- */
  .mstrip,
  .mcount {
    display: none;
  }

  @media (max-width: 720px) {
    .stage-wrap {
      display: none;
    }
    .mstrip {
      display: flex;
      gap: 8px;
      margin-left: calc(-1 * var(--gutter-l));
      margin-right: calc(-1 * var(--gutter-r));
      padding-inline: var(--gutter-l) var(--gutter-r);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 24px;
      scrollbar-width: none;
    }
    .mstrip::-webkit-scrollbar {
      display: none;
    }
    .mstrip:focus-visible {
      outline-offset: -2px;
    }
    .mcard {
      flex: 0 0 84%;
      display: block;
      scroll-snap-align: center;
      text-decoration: none;
      border-radius: var(--radius);
      transition:
        transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 0.35s;
    }
    /* Walkthrough cards: the clip keeps its own shape, centered on the same gradient,
       with its top and bottom edges faded into the card. */
    .mvid {
      display: flex;
      align-items: center;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: var(--radius);
      background: linear-gradient(135deg, #f5f7f9, #dce3ee 50%, #c6d1e1);
    }
    .mvid video {
      display: block;
      width: 100%;
      height: auto;
      mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
    }
    /* Archive card: the stage panel, sized to the card */
    .marc {
      aspect-ratio: 4 / 5;
      gap: 18px;
      padding: 0 8%;
      border-radius: var(--radius);
      container-type: inline-size;
    }
    .marc .acols {
      gap: 7%;
    }
    .marc .agroup-t {
      margin-bottom: 10px;
      padding-bottom: 8px;
      font-size: 11px;
    }
    .marc .anames {
      font-size: 6.4cqi;
    }
    .mcard :global(.ph) {
      border-radius: var(--radius);
    }
    .mcard:not(.on) {
      transform: scale(0.96);
      opacity: 0.7;
    }
    .mcount {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-top: 14px;
    }
    [data-mhint] {
      transition: opacity 0.3s;
    }
    .dots {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .dots i {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--line);
      transition:
        background 0.2s,
        width 0.2s;
    }
    .dots i.on {
      width: 14px;
      border-radius: 3px;
      background: var(--fg);
    }
    .index {
      margin-top: 20px;
    }
    .pick:not([data-on]) .r {
      display: none;
    }
    .n {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
