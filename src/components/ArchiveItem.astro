---
/** An archive tile: image, name, one line, a short description, and the role or context. */
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import DraftText from './DraftText.astro';
import { SHOW_DRAFTS, stripDrafts } from '../lib/drafts';

interface Props {
  entry: CollectionEntry<'archive'>;
}
const { entry } = Astro.props;
const { name, meta, line, text, tone, images } = entry.data;
// Placeholder-only descriptions are dropped in production, so skip the empty paragraph.
const showText = SHOW_DRAFTS || stripDrafts(text).length > 0;
---

<li class="atile">
  <Media src={images[0]?.src} alt={images[0]?.alt ?? ''} tone={tone} tag={name} ratio="4/3" size="half" />
  <h3 class="t">{name}</h3>
  <p class="d">{line}</p>
  {
    showText && (
      <p class="x">
        <DraftText text={text} />
      </p>
    )
  }
  <p class="tags"><DraftText text={meta} /></p>
</li>

<style>
  .atile {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
  }
  .atile :global(.ph) {
    width: 100%;
  }
  .atile p {
    margin: 0;
  }
  /* Image, then title and line as one unit, then description and role */
  .t {
    margin: 6px 0 0;
    font-family: var(--display);
    font-weight: var(--bold);
    font-size: 18px;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .d {
    margin-top: -4px !important;
    font-size: 14px;
    line-height: 1.45;
    color: var(--fg-2);
  }
  .x {
    max-width: 52ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .tags {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
