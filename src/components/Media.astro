---
/**
 * The image frame used everywhere.
 *   contain (default): screenshot floated on a project-tone panel, with a soft shadow.
 *   cover: image fills the frame.
 *   flat: transparent PNG export, no panel, no frame.
 * With no src it renders a tone placeholder; `tag` labels it in dev and previews.
 */
import Img from './Img.astro';
import { image } from '../lib/images';
import { SHOW_DRAFTS } from '../lib/drafts';
import { lqip } from '../lib/lqip';
import type { Tone } from '../lib/site';

type Size = 'full' | 'wide' | 'half' | 'third' | 'quarter';

interface Props {
  src?: string | undefined;
  alt?: string | undefined;
  fit?: 'contain' | 'cover' | 'flat' | undefined;
  tone?: Tone | undefined;
  /** CSS aspect-ratio. Defaults to the image's own ratio. */
  ratio?: string | undefined;
  /** Fixed CSS height instead of a ratio (used by heroes). */
  height?: string | undefined;
  bg?: string | undefined;
  /** Which part of a cover image stays in view when cropped, as CSS object-position. e.g. "top". */
  focus?: string | undefined;
  /** Placeholder label for an image still to come. */
  tag?: string | undefined;
  /** Rendered width, for responsive image selection. */
  size?: Size | undefined;
  /** 16px corners for large single images. */
  large?: boolean | undefined;
  priority?: boolean | undefined;
  /** Render a tiny blurred preview under the image, for the hero entrance. */
  blurUp?: boolean | undefined;
  /** Show a blurred preview while the image loads, then fade it in. On by default. */
  soft?: boolean | undefined;
  only?: 'mobile' | 'desktop' | undefined;
  class?: string | undefined;
  style?: string | undefined;
  [key: `data-${string}`]: string | undefined;
}

const {
  src,
  alt = '',
  fit = 'contain',
  tone = 'hub',
  ratio,
  height,
  bg,
  focus,
  tag,
  size = 'wide',
  large = false,
  priority = false,
  blurUp = false,
  soft = true,
  only,
  class: className,
  style: extraStyle,
  ...rest
} = Astro.props;

const SIZES: Record<Size, string> = {
  full: '100vw',
  wide: '(min-width: 1288px) 1240px, calc(100vw - 48px)',
  half: '(min-width: 1288px) 620px, (min-width: 721px) 50vw, 100vw',
  third: '(min-width: 1288px) 420px, (min-width: 721px) 34vw, 100vw',
  quarter: '(min-width: 1288px) 310px, (min-width: 721px) 25vw, 50vw',
};

const meta = src ? image(src) : null;
const aspect = height ? undefined : (ratio ?? (meta ? `${meta.width}/${meta.height}` : '16/9'));

const style = [
  `--tone:var(--t-${tone})`,
  aspect && `aspect-ratio:${aspect}`,
  height && `height:${height}`,
  bg && `background:${bg}`,
  focus && `--focus:${focus}`,
  extraStyle,
]
  .filter(Boolean)
  .join(';');

const placeholder = !src;
// The hero handles its own preview in motion.css; other photos use the load fade below.
const loadFade = Boolean(src) && soft && !blurUp;
const preview = src && (blurUp || loadFade) ? await lqip(src) : null;
---

<div
  class:list={['ph', fit, { large, placeholder, soft: loadFade }, className]}
  style={style}
  data-size={size}
  role={placeholder && SHOW_DRAFTS ? 'img' : undefined}
  aria-label={placeholder && SHOW_DRAFTS ? `Placeholder: ${tag ?? 'image'}` : undefined}
  aria-hidden={placeholder && !SHOW_DRAFTS ? 'true' : undefined}
  {...rest}
>
  {preview && <img class="lqip" src={preview} alt="" aria-hidden="true" />}
  {src && <Img class="shot" src={src} alt={alt} sizes={SIZES[size]} priority={priority} only={only} />}
  {placeholder && SHOW_DRAFTS && tag && <span class="tag draft">[{tag}]</span>}
</div>

<style>
  .ph {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--tone);
  }
  .large {
    border-radius: var(--radius-lg);
  }
  .ph :global(.shot) {
    max-width: 90%;
    max-height: 86%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 18px 44px rgb(40 20 90 / 0.16);
  }
  .cover :global(.shot) {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: var(--focus, center);
    border-radius: 0;
    box-shadow: none;
    background: none;
  }
  .flat {
    background: transparent;
    border-radius: 0;
  }
  .flat :global(.shot) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 0;
    box-shadow: none;
    background: none;
  }
  /* Blurred preview: sits where the image will land, removed by the hero entrance (see motion.css) */
  .lqip {
    position: absolute;
    inset: 7% 5%;
    width: 90%;
    height: 86%;
    object-fit: contain;
    filter: blur(18px);
    display: none;
  }
  .cover .lqip,
  .flat .lqip {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cover .lqip {
    object-fit: cover;
    object-position: var(--focus, center);
    transform: scale(1.08);
  }
  /* Load fade: the preview shows at once, the image fades in over it once fully loaded,
     however slow the connection. Without JS the image simply paints over the preview. */
  .soft .lqip {
    display: block;
    border-radius: 8px;
  }
  .cover.soft .lqip,
  .flat.soft .lqip {
    border-radius: 0;
  }
  .soft :global(.shot) {
    position: relative;
    transition: opacity 0.5s var(--ease);
  }
  .soft :global(.shot.wait) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .soft :global(.shot) {
      transition: none;
    }
  }
  .tag {
    position: absolute;
    left: 16px;
    bottom: 14px;
    padding: 3px 7px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
</style>

<script>
  // Hide images that haven't fully arrived, then fade each one in over its preview once loaded.
  for (const img of document.querySelectorAll<HTMLImageElement>('.soft img.shot')) {
    if (img.complete) continue;
    img.classList.add('wait');
    const show = () => img.classList.remove('wait');
    img.addEventListener('load', show, { once: true });
    img.addEventListener('error', show, { once: true });
  }
</script>
