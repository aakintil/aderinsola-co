---
/**
 * Full-bleed hero image with a 12px side gutter, up to --hero-max wide (centered beyond that,
 * so a zoomed-out or very wide window doesn't stretch it). Fades in from an 18px blur.
 */
import Media from './Media.astro';
import type { Project } from '../lib/projects';

interface Props {
  hero: Project['data']['hero'];
  tone: Project['data']['tone'];
}
const { hero, tone } = Astro.props;
const flat = hero.fit === 'flat';
// A cover hero with a ratio is a composed image: on phones it keeps that ratio, so it shrinks to fit instead of cropping.
const fitPhone = hero.fit === 'cover' && hero.ratio;
---

<div class="bleed hero">
  <Media
    src={hero.src}
    alt={hero.alt}
    fit={hero.fit}
    tone={hero.tone ?? tone}
    bg={hero.bg}
    focus={hero.focus}
    ratio={flat ? hero.ratio : undefined}
    height={flat ? undefined : 'clamp(320px, 52vw, 720px)'}
    style={flat ? 'max-height:780px;margin-inline:auto' : fitPhone ? `--phone-ratio:${hero.ratio}` : undefined}
    class={fitPhone ? 'fit-phone' : undefined}
    size="full"
    large
    priority
    blurUp
    data-enter="hero"
  />
</div>

<style>
  /* The project color field from the header runs down behind the top of the hero */
  .hero {
    background: var(--project-field) top / 100% 62% no-repeat;
  }
  .hero > :global(*) {
    max-width: var(--hero-max);
    margin-inline: auto;
  }
  @media (max-width: 720px) {
    .hero > :global(.fit-phone) {
      height: auto !important;
      aspect-ratio: var(--phone-ratio);
    }
  }
</style>
