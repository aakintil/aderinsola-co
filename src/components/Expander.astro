---
/**
 * Native <details>, so it works with JS off. src/scripts/expander.ts adds the
 * height and opacity animation when motion is allowed.
 */
interface Props {
  summary: string;
}
---

<details class="xp">
  <summary>
    <span class="icon" aria-hidden="true">
      {/* Material Symbols "expand_more" (Apache 2.0). Points down when closed, up when open. */}
      <svg viewBox="0 -960 960 960" width="18" height="18"><path d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z"></path></svg>
    </span>{Astro.props.summary}
  </summary>
  <div class="more">
    <slot />
  </div>
</details>

<style>
  /* Closed, it is a link. Open, the content is a full-width white panel. */
  details {
    width: 100%;
  }
  summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .icon svg {
    fill: currentColor;
    transition: transform var(--t-expand) var(--ease);
  }
  details[open] .icon svg {
    transform: rotate(180deg);
  }
  details:global(.closing) .icon svg {
    transform: none;
  }
  summary:hover .icon {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  /* Two columns: text and lists take one, images take both unless they're half-size.
     Bold-led points pair up side by side; a half image sits beside the point it shows. */
  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 24px 48px;
    margin-top: 12px;
    padding: 32px 36px 36px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .more > :global(*) {
    min-width: 0;
  }
  .more > :global(:is(.ph, .vid, .cycle, .grid, .draft):not([data-size='half'])) {
    grid-column: 1 / -1;
  }
  .more :global(p) {
    margin: 0;
  }
  .more :global(strong) {
    color: var(--fg-2);
  }
  @media (max-width: 720px) {
    .more {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      margin-inline: -8px;
      padding: 22px 20px 24px;
    }
  }
  /* Numbered steps: 01, 02, 03 */
  .more :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    counter-reset: step;
  }
  /* The number hangs, so a wrapped line lines up with the text, not under the number */
  .more :global(ol > li) {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr);
  }
  .more :global(ol > li)::before {
    content: counter(step, decimal-leading-zero);
    font-weight: 600;
    color: var(--accent);
  }
  /* A list on its own spreads across both columns, two items per row */
  .more > :global(ol:only-child) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 48px;
  }
  @media (max-width: 720px) {
    .more > :global(ol:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
