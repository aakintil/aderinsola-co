---
/**
 * Native <details>, so it works with JS off. src/scripts/expander.ts adds the
 * height and opacity animation when motion is allowed.
 */
interface Props {
  summary: string;
}
---

<details class="xp">
  <summary>
    <span class="icon" aria-hidden="true">
      {/* Material Symbols "expand_more" (Apache 2.0). Points down when closed, up when open. */}
      <svg viewBox="0 -960 960 960" width="18" height="18"><path d="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z"></path></svg>
    </span>{Astro.props.summary}
  </summary>
  <div class="more">
    <slot />
  </div>
</details>

<style>
  details {
    max-width: 620px;
  }
  summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .icon svg {
    fill: currentColor;
    transition: transform var(--t-expand) var(--ease);
  }
  details[open] .icon svg {
    transform: rotate(180deg);
  }
  details:global(.closing) .icon svg {
    transform: none;
  }
  summary:hover .icon {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .more {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 4px 0 8px 32px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .more :global(p) {
    margin: 0;
  }
  /* Numbered steps: 01, 02, 03 */
  .more :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    counter-reset: step;
  }
  .more :global(ol > li) {
    counter-increment: step;
  }
  .more :global(ol > li)::before {
    content: counter(step, decimal-leading-zero);
    margin-right: 12px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
