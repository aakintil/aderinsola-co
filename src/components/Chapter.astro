---
/**
 * One chapter of a case study: media, then eyebrow, H2, sub text and an optional expander.
 *
 *   <Chapter eyebrow="01 · The problem" title="Great tools nobody could find.">
 *     <Media slot="media" ... />
 *     Sub text as a plain paragraph.
 *     <Expander summary="What we saw">...</Expander>
 *     <Decision slot="after" ... />
 *   </Chapter>
 */
import DraftText from './DraftText.astro';
import { slugify } from '../lib/site';

interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id = slugify(title) } = Astro.props;
---

<section class="chapter" aria-labelledby={id}>
  <slot name="media" />
  <div class="ctext">
    <p class="eyebrow"><DraftText text={eyebrow} /></p>
    <h2 class="h2" id={id}>{title}</h2>
    <slot />
  </div>
  {
    Astro.slots.has('after') && (
      <div class="after">
        <slot name="after" />
      </div>
    )
  }
</section>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: var(--gap-media);
    padding-bottom: var(--gap-section);
    scroll-margin-top: 24px;
  }
  /* Full chapter width so an open expander can spread out; the heading keeps a reading width */
  .ctext {
    display: flex;
    flex-direction: column;
    gap: var(--gap-text);
  }
  .ctext > .h2 {
    max-width: 760px;
  }
  /* The eyebrow labels the heading, so it sits tighter to it than the heading does to its text */
  .ctext > .eyebrow {
    margin-bottom: calc(var(--gap-tight) - var(--gap-text));
  }
  /* The expander continues the sub text; its 44px tap target already adds air */
  .ctext > :global(details) {
    margin-top: calc(var(--gap-tight) - var(--gap-text));
  }
  .after {
    margin-top: calc(var(--gap-related) - var(--gap-media));
  }
  /* MDX paragraphs in the default slot are the chapter's sub text */
  .ctext > :global(p:not(.eyebrow)) {
    margin: 0;
    max-width: 620px;
    font-family: var(--display);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
