---
/** A ruled section near the end of a page: "What I'd keep", "What customers said". */
import { slugify } from '../lib/site';

interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
const id = `s-${slugify(eyebrow)}`;
---

<section class="closing" aria-labelledby={id}>
  <h2 class="eyebrow" id={id}>{eyebrow}</h2>
  <slot />
</section>

<style>
  .closing {
    display: flex;
    flex-direction: column;
    gap: var(--gap-media);
    /* Closing sections sit closer together than chapters do: half the usual space */
    padding-block: calc(var(--gap-related) / 2) calc(var(--gap-section) / 2);
    border-top: 1px solid var(--line);
  }
  /* Halve the space a chapter leaves before the first closing section */
  :global(.chapter) + .closing {
    margin-top: calc(var(--gap-section) / -2);
  }
</style>
