# Local development: a folder that holds the two GT Flexa WOFF2 files.
# FONTS_DIR=~/Fonts/gt-flexa

# CI / Vercel: read-only token for the private fonts repo.
# FONTS_REPO_TOKEN=github_pat_...
# FONTS_REPO=aakintil/aderinsola-fonts
# FONTS_REPO_REF=main

# Show draft placeholders in a production build (they always show in dev and on Vercel previews).
# SHOW_DRAFTS=true
